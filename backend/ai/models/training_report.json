    "total_records": 5000,
    "training_samples": 2480,
    "testing_samples": 1000,
    "features": [
        "flow_rate",
        "pressure_bar",
        "ph",
        "turbidity",
        "tds",
        "total_litres",
        "hour_of_day",
        "day_of_week"
    ],
    "accuracy": 0.838,
    "f1_score": 0.8089622641509434,
    "roc_auc": 0.9435950764006791,
    "labels": {
        "normal": "Normal",
        "anomaly": [
            "leakage",
            "water_quality",
            "theft",
            "sensor_fault"
        ]
    }
}